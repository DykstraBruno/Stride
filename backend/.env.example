# Neon PostgreSQL — obtenha em https://neon.tech (free tier disponível)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
PORT=3001
NODE_ENV=development

# Groq — obtenha sua chave grátis em https://console.groq.com
# Modelos disponíveis: llama-3.1-8b-instant (rápido) | llama-3.3-70b-versatile (melhor qualidade)
GROQ_API_KEY="sua-chave-aqui"
GROQ_MODEL="llama-3.1-8b-instant"
